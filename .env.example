# GraphRAG API 配置
# 复制此文件为 .env 并填入你的 API 密钥

# DeepSeek API 密钥（主要的 LLM 模型）
# 获取地址：https://platform.deepseek.com/api_keys
GRAPHRAG_API_KEY=your_deepseek_api_key_here

# OpenAI API 密钥（用于嵌入模型）
# 获取地址：https://platform.openai.com/api-keys
GRAPHRAG_EMBEDDING_API_KEY=your_openai_api_key_here

# 可选：如果你想完全使用 DeepSeek，可以将嵌入模型也改为 DeepSeek
# 但需要修改 settings.yaml 中的 embeddings 配置